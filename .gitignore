# Python
__pycache__/
*.py[cod]
*.pyo

# macOS
.DS_Store

# PyCharm
.idea/

# VS Code
.vscode/

# Claude Code
# No trailing slash: on the HPC checkout .claude is a symlink into Box, and a
# directory-only pattern would not match it.
.claude
.claude_conversations

# Markdown docs (physical copies live in Box)
*.md

# Ensemble chunk directories: intermediates, redundant with the merged arrays and
# reproducible from the fixed per-chunk seeds.
data/ensemble30x30/
data/fieldRangeSweep/screen*/
data/fieldRangeReplicate/screen*/

# SLURM array logs
Error_*.err
slurm*.out

# Old run logs kept outside the history
archive/

# Raw run checkpoints: regenerable from the seeded training and recurrence
# scripts, and redundant with the summary JSONs the reports are built from.
data/boundaryHarmonicTraining1888Hold301FaceMinus60Minus5Knockout/
data/boundaryHarmonicTraining1888Hold301FaceOutlineMinus60Minus5Ceiling2*/
data/boundaryRecurrence1888Hold301*/

# The stripes' raw training checkpoints (about 5 MB each, 900 MB in all): regenerable from the seeded training, and redundant with
# data/boundaryHarmonicTrainingRestartRecords1888Hold301StripesInteriorMinus60Minus5.json (what the report's ladder is built from) and the summary
# JSONs. The one checkpoint the mechanism analyses load by name, the stripe code itself, is kept.
data/boundaryHarmonicTraining1888Hold301StripesInteriorMinus60Minus5*/*
!data/boundaryHarmonicTraining1888Hold301StripesInteriorMinus60Minus5Ceiling2/order2_restart06.npz
